# Response headers for every page and file on dearkarl.com (static assets;
# the Worker's own /api and /mcp responses are not affected).
#
# The CSP is the site's privacy claim made checkable: scripts, styles, fonts,
# images and connections only from this origin. Analytics go to /k/ on this
# origin (worker/index.ts forwards them to PostHog EU); the browser can reach no
# analytics host directly. Loosening any of this is its own written decision.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: interest-cohort=(), browsing-topics=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable
